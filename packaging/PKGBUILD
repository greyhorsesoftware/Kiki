# Maintainer: David Clark <david.j.clark@icloud.com>
# Source package: builds kiki from the tagged release tarball, so it builds anywhere a PKGBUILD
# can — a clean chroot, omarchy-pkgs, a stranger's machine (docs/0.3.0/02-omarchy-store.md).
#
#   KIKI_LOCAL_SRC=1 makepkg   builds the checkout one level up instead: the release checklist
#                              and CI, which package the commit under test before it has a tag.
#                              Named here and nowhere else, on purpose: a PKGBUILD that quietly
#                              preferred a nearby checkout is what a clean-chroot build exists
#                              to catch. (A rustup toolchain needs `-d`: pacman does not know it.)
pkgname=kiki
pkgver=0.5.0
pkgrel=1
pkgdesc="A fast file manager for Omarchy: Rust daemon, Quickshell front end"
arch=('x86_64' 'aarch64')
url="https://github.com/greyhorsesoftware/Kiki"
license=('MIT')
# What each dependency is for (docs/0.3.0/02-omarchy-store.md, decision 6 — each was checked by
# taking it away and running the tests that use it, which CI repeats: `.github/workflows/ci.yml`,
# "Dependency audit"):
#   quickshell, qt6-declarative  the window itself
#   qt6-multimedia               the player Quick Look shows a video with (docs/0.2.0/05-quicklook.md)
#   xdg-desktop-portal           the file-chooser portal kiki's listener serves (kiki.portal)
#   ffmpeg                       ffmpegthumbnailer-style frames for video thumbnails
#   libsecret                    `secret-tool`, which is how kiki stores a location's password;
#                                which Secret Service answers it is the desktop's — see optdepends
#   libarchive                   `bsdtar`, for archives
#   udisks2                      `udisksctl`, for mounting devices
#   poppler                      `pdftoppm`, which draws PDF pages for thumbnails and Quick Look
#   glib2                        what the SMB plugin links (gio); the backend it talks to is optional
# Not depends, and why:
#   gnome-keyring  kiki runs without any Secret Service — saving a password then fails with one
#                  numbered sentence (1261, "is a Secret Service running?") and nothing else is
#                  affected; on Omarchy gnome-keyring is there anyway, and KWallet or KeePassXC
#                  serve the same API.
#   git            the repository overlay in listings; without git a repository is listed as a
#                  plain folder (git.rs: a status that cannot run is "not a repository", never an
#                  error). Cargo needs no git either: Cargo.lock has no git sources.
#   gvfs           `gvfsd`, which the SMB plugin asks for a share; without it an SMB location
#                  answers Unsupported, naming the packages to install, and every other kind of
#                  location is untouched. It goes with gvfs-smb, which was always optional.
depends=('quickshell' 'xdg-desktop-portal' 'ffmpeg' 'libsecret' 'libarchive' 'udisks2'
         'qt6-declarative' 'qt6-multimedia' 'poppler' 'glib2')
makedepends=('rust' 'cargo' 'clang' 'pkgconf' 'glib2')
optdepends=('gnome-keyring: remember passwords for SFTP, FTPS and SMB locations (any Secret Service will do)'
            'git: repository status and branches in listings'
            'gvfs: SMB (Windows share) locations, with gvfs-smb'
            'gvfs-smb: SMB (Windows share) locations, with gvfs'
            'gvfs-wsdd: find Windows computers on the network'
            'openssh: SFTP host key tools'
            'noto-fonts-cjk: Japanese on screen (the interface is in English, Spanish and Japanese)'
            'tailscale: share files over Taildrop')
install=kiki.install
options=('!lto' '!debug')

# The source is the tag's tarball, whose digest the release workflow writes below when it tags
# (`.github/workflows/release.yml`, "Write the checksums back"): between a version bump and its
# release the line holds a digest that can match nothing, so a package built from it fails its
# checksum on purpose rather than building an untagged tree as if it were the release. With
# KIKI_LOCAL_SRC there is no source at all: the checkout is the source.
if [ -z "${KIKI_LOCAL_SRC:-}" ]; then
  source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
  sha256sums=('cdd6c521ecb236219a6549732b41476821c31341c82604d9a8182568feeda499')
  _srcdir="${srcdir}/Kiki-${pkgver}"
else
  source=()
  sha256sums=()
  _srcdir="${startdir}/.."
fi

# Cargo builds under makepkg's own tree unless the caller has a target directory already —
# CI does, cached between runs, and a release build from cold is the slowest thing it does.
_target() { echo "${CARGO_TARGET_DIR:-${srcdir}/target}"; }

build() {
  cd "${_srcdir}"
  export CARGO_TARGET_DIR="$(_target)"
  cargo build --release --locked
}

check() {
  cd "${_srcdir}"
  export CARGO_TARGET_DIR="$(_target)"
  cargo test --release --locked
}

package() {
  local t="$(_target)/release"
  install -Dm755 "${t}/kikid"            "${pkgdir}/usr/bin/kikid"
  # The only part of kiki that decodes a file's contents, and so the only part a malformed file
  # can bring down. kikid looks for it beside itself, then here. Without it: no thumbnails.
  install -Dm755 "${t}/kiki-thumber"     "${pkgdir}/usr/lib/kiki/kiki-thumber"
  install -Dm755 "${t}/kiki-plugin-sftp" "${pkgdir}/usr/lib/kiki/plugins/kiki-plugin-sftp"
  install -Dm755 "${t}/kiki-plugin-ftps" "${pkgdir}/usr/lib/kiki/plugins/kiki-plugin-ftps"
  for p in share-mail share-tailscale; do
    install -Dm755 "${t}/kiki-plugin-$p" "${pkgdir}/usr/lib/kiki/plugins/kiki-plugin-$p"
  done
  # Not a plugin any more: kiki's face on the session bus is a program the BUS starts, which
  # puts the request to a window and has no connection to the daemon at all
  # (docs/0.3.0/01-daemon-on-demand.md).
  install -Dm755 "${t}/kiki-plugin-dbus" "${pkgdir}/usr/libexec/kiki/kiki-dbus"
  # What a user's "Show in folder" row LINKS to from ~/.local/share/dbus-1/services: a link into
  # the package dangles when the package is gone, and the bus skips a service file it cannot
  # read, so removing kiki hands the name back to whoever owns it system-wide with nothing to
  # clean up (docs/0.3.0/01-daemon-on-demand.md, decision 4).
  install -Dm644 "${_srcdir}/packaging/user-services/org.freedesktop.FileManager1.service" "${pkgdir}/usr/share/kiki/dbus-1/services/org.freedesktop.FileManager1.service"
  # A location kind is the suffix of the name the plugin is run by: gio goes in as smb.
  install -Dm755 "${t}/kiki-plugin-gio" "${pkgdir}/usr/lib/kiki/plugins/kiki-plugin-smb"
  # WebDAV and AFP are not in 0.1.0: adding one back is this list and plugin::LOCATION_KINDS.
  # The device plugins (ptp mtp afc) are in git history, not the tree (plan 17).
  install -Dm755 "${_srcdir}/packaging/bin/kiki" "${pkgdir}/usr/bin/kiki"

  install -d "${pkgdir}/usr/share/kiki"
  cp -r "${_srcdir}/qml/." "${pkgdir}/usr/share/kiki/"

  # No systemd units: the daemon is the window's engine, started by the window and gone with it
  # (docs/0.3.0/01-daemon-on-demand.md). `kiki.install` sweeps up what the old hook enabled.
  install -Dm644 "${_srcdir}/packaging/org.kiki.App.desktop"  "${pkgdir}/usr/share/applications/org.kiki.App.desktop"
  # The mark the desktop entry names, and the one the About panel tints to the current theme.
  install -Dm644 "${_srcdir}/app-images/cat-head-wireframe.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/org.kiki.App.svg"
  # No org.kiki.App D-Bus service and no DBusActivatable in the entry: nothing in kiki owns that
  # name, so a launcher that activated it would wait on a name nobody claims and lose its URIs.
  # `Exec=kiki %U` is how kiki starts, and the launcher hands a second start to the first.
  install -Dm644 "${_srcdir}/packaging/org.freedesktop.impl.portal.desktop.kiki.service" "${pkgdir}/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.kiki.service"
  install -Dm644 "${_srcdir}/packaging/kiki.portal"           "${pkgdir}/usr/share/xdg-desktop-portal/portals/kiki.portal"
  # kiki.portal only makes the chooser AVAILABLE. Whether it is used is each user's choice, made
  # in kiki's first-run dialog, which writes ~/.config/xdg-desktop-portal/portals.conf
  # (FileChooser=kiki;gtk — beside GTK's, which stays the fallback). A system-wide
  # kiki-portals.conf was shipped here once; xdg-desktop-portal reads <desktop>-portals.conf, so
  # on Hyprland a file of that name was never read, and it said something the dialog does not.
  install -Dm644 "${_srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
