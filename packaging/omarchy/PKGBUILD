# Maintainer: David Clark <david.j.clark@icloud.com>
# The Omarchy store's package (docs/0.3.0/02-omarchy-store.md): what goes in `pkgbuilds/kiki/`
# of omarchy-pkgs. It repackages the release asset GitHub serves for each architecture — the
# very bytes CI built and tested — so the store's builders download a small package and need no
# Rust toolchain, which the checklist prefers. packaging/PKGBUILD is the source package, for CI
# and for building a checkout; `install.sh` at the repository root installs the same asset
# without either. Kept in step with packaging/PKGBUILD by hand; the checksums by the release.
pkgname=kiki
pkgver=0.5.0
pkgrel=1
pkgdesc="A fast file manager for Omarchy: Rust daemon, Quickshell front end (binary release)"
arch=('x86_64' 'aarch64')
url="https://github.com/greyhorsesoftware/Kiki"
license=('MIT')
# Keep in step with packaging/PKGBUILD, where each entry is explained.
depends=('quickshell' 'xdg-desktop-portal' 'ffmpeg' 'libsecret' 'libarchive' 'udisks2'
         'qt6-declarative' 'qt6-multimedia' 'poppler' 'glib2')
optdepends=('gnome-keyring: remember passwords for SFTP, FTPS and SMB locations (any Secret Service will do)'
            'git: repository status and branches in listings'
            'gvfs: SMB (Windows share) locations, with gvfs-smb'
            'gvfs-smb: SMB (Windows share) locations, with gvfs'
            'gvfs-wsdd: find Windows computers on the network'
            'openssh: SFTP host key tools'
            'noto-fonts-cjk: Japanese on screen (the interface is in English, Spanish and Japanese)'
            'tailscale: share files over Taildrop')
install=kiki.install
# The asset is a finished package: nothing to strip, no debug symbols to split off — without this
# makepkg's defaults produced an empty kiki-debug package beside the real one.
options=('!strip' '!debug')
# The download is given a name of its own (`name::url`): the asset is called exactly what this
# package will be called, and makepkg took the fetched asset for a package already built and
# refused to build ("use -f to overwrite", the v0.4.0 release, 2026-09-28).
source_x86_64=("${pkgname}-${pkgver}-x86_64-release.pkg.tar.zst::${url}/releases/download/v${pkgver}/${pkgname}-${pkgver}-1-x86_64.pkg.tar.zst")
source_aarch64=("${pkgname}-${pkgver}-aarch64-release.pkg.tar.zst::${url}/releases/download/v${pkgver}/${pkgname}-${pkgver}-1-aarch64.pkg.tar.zst")
# The release's own digests, written here by the release workflow as it publishes
# (`.github/workflows/release.yml`, "Write the checksums back") — never copied from anywhere but
# the build that produced the asset. Between a version bump and its release the lines hold a
# digest that matches nothing, so a build from them fails its checksum rather than installing
# something unverified. Not SKIP: SKIP would install anything.
sha256sums_x86_64=('dc57c91eaf5cfdd9e8048cd2578bcf8d8c9b8c0686d9c66deebc4c2be79643ed')
sha256sums_aarch64=('134fa075930f6c7383c7bf57e58c565cdb38f388d504ff87f9c44b50b1cae939')

package() {
  # The release asset is a complete pacman package; unpack its payload into $pkgdir.
  bsdtar -xf "${srcdir}/${pkgname}-${pkgver}-${CARCH}-release.pkg.tar.zst" -C "${pkgdir}" \
    --exclude .PKGINFO --exclude .BUILDINFO --exclude .MTREE --exclude .INSTALL
}
