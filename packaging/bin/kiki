#!/bin/sh
# kiki launcher: one window per session; a URI argument opens or focuses it.
set -e
SHELL_DIR="${KIKI_SHELL_DIR:-/usr/share/kiki}"
if qs -c kiki ipc show >/dev/null 2>&1; then
  exec qs -c kiki ipc call shell open "${1:-file://$HOME}"
fi
exec qs -p "${SHELL_DIR}/shell.qml" -- "${1:-file://$HOME}"
